{
  // Astro 7 + @astrojs/cloudflare 14: the adapter's vite plugin supplies the
  // Worker entry point, so `main` must NOT be hardcoded to the old
  // dist/_worker.js/index.js path (it does not exist at config-resolution time
  // and the build fails). Bindings stay here.
  "name": "digipincode",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "assets": {
    "directory": "./dist"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pincode-india-db",
      "database_id": "74274a3f-9fca-42ec-9fbf-c707ffbc56a4"
    },
    {
      "binding": "SEO_DB",
      "database_name": "seo-keywords-db",
      "database_id": "b3d0300d-7362-489e-91e9-d2dfece64b63"
    }
  ]
}
