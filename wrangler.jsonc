{
  "name": "digipincode",
  "main": "dist/_worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pincode-india",
      "database_id": "YOUR_D1_DATABASE_ID"
    }
  ]
}
