{
  "name": "digipincode",
  "main": "dist/_worker.js/index.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  },
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "712a25b4ffc54a308d305e22be3b658c"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pincode-india-db",
      "database_id": "74274a3f-9fca-42ec-9fbf-c707ffbc56a4"
    }
  ]
}
