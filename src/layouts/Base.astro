---
import { SITE, NAV_LINKS, FOOTER_LINKS } from '../config/site';
interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'India Pincode Directory',
  description = 'Search any Indian pincode, village, or panchayat. Complete directory with LGD codes, census data, and local body information.'
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>📮</text></svg>" />
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Digipincode" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={Astro.url.href} />
  <link rel="canonical" href={Astro.url.href} />
  <link rel="sitemap" href="/sitemap.xml" />
  <script is:inline src="https://analytics.ahrefs.com/analytics.js" data-key="gOliiXpzU4P4bK1z+5QfgA" async></script>
  <script>
    import { initFeedbackButtons } from '../components/FeedbackWidget';
    initFeedbackButtons();
  </script>
  <slot name="head" />
</head>
<body>
  <header>
    <nav>
      {NAV_LINKS.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
  </header>
  <main>
    <slot />
  </main>
  <footer>
    <div class="footer-cols">
      <div>
        <p><strong>{SITE.name}</strong> — 6 lakh villages, panchayats & pincodes</p>
        <p>
          <a href="/search">Search</a> ·
          <a href="/states">States</a> ·
          <a href="/chhath/">Chhath 2026</a>
        </p>
      </div>
      <div>
        {FOOTER_LINKS.map((l) => <p><a href={l.href}>{l.label}</a></p>)}
      </div>
    </div>
    <p>© {new Date().getFullYear()} {SITE.name} · SKM Studio Network</p>
  </footer>
</body>
</html>

<style>
  body { font-family: system-ui, sans-serif; max-width: 960px; margin: 0 auto; padding: 1rem; color: #1a1a1a; }
  header { border-bottom: 1px solid #ddd; padding: .5rem 0; }
  header nav { display: flex; flex-wrap: wrap; gap: .5rem .75rem; }
  header nav a { text-decoration: none; color: #1a1a1a; font-weight: 600; }
  main { padding: 1rem 0; }
  footer { border-top: 1px solid #ddd; padding: .5rem 0; font-size: .85rem; color: #666; }
  .footer-cols { display: flex; flex-wrap: wrap; gap: 1rem 2rem; justify-content: space-between; }
  .footer-cols p { margin: .25rem 0; }
  table.details { border-collapse: collapse; margin: 1rem 0; }
  table.details th { text-align: left; padding: .4rem .8rem; background: #f5f5f5; border: 1px solid #ddd; }
  table.details td { padding: .4rem .8rem; border: 1px solid #ddd; }
  .breadcrumb { font-size: .85rem; color: #666; margin-bottom: 1rem; }
  .breadcrumb a { color: #0066cc; }
  .desc { color: #444; line-height: 1.5; }
  ul { padding-left: 1.2rem; }
  li { margin: .3rem 0; }
  a { color: #0066cc; }
</style>
