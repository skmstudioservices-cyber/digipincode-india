---
import { SITE, NAV_LINKS, FOOTER_LINKS, FRESHNESS, fmtDate } from '../config/site';
interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'India Pincode Directory',
  description = 'Search any Indian pincode, village, or panchayat. Complete directory with LGD codes, census data, and local body information.'
} = Astro.props;
const BASE = 'https://digipincode.india-in.workers.dev';
const orgLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': `${BASE}/#website`, name: 'Digipincode', url: `${BASE}/`, inLanguage: 'en-IN',
      potentialAction: { '@type': 'SearchAction', target: { '@type': 'EntryPoint', urlTemplate: `${BASE}/search?q={search_term_string}` }, 'query-input': 'required name=search_term_string' } },
    { '@type': 'Organization', '@id': `${BASE}/#org`, name: 'Digipincode — SKM Studio Network', url: `${BASE}/` },
  ],
};
const POPULAR = [
  ['Delhi', '110001'], ['Mumbai', '400001'], ['Kolkata', '700001'], ['Chennai', '600001'],
  ['Bengaluru', '560001'], ['Hyderabad', '500001'], ['Pune', '411001'], ['Ahmedabad', '380001'],
  ['Jaipur', '302001'], ['Lucknow', '226001'], ['Patna', '800001'], ['Bhopal', '462001'],
  ['Chandigarh', '160001'], ['Guwahati', '781001'], ['Kochi', '682001'], ['Nagpur', '440001'],
];
// Facilities shown on every page — simple English, honest collection status.
const FACILITIES = [
  ['🛣️', 'Road'],
  ['🚰', 'Drinking water'],
  ['⚡', 'Electricity'],
  ['🏫', 'School'],
  ['🏥', 'Hospital / clinic'],
  ['🚌', 'Bus stop'],
  ['🚆', 'Railway station'],
  ['📶', 'Mobile network'],
  ['🏦', 'Bank / ATM'],
  ['⭐', 'Famous for'],
];
const COLLECTING = 'Coming soon — we are collecting this from government records';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-30JK9GG08F"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    var GA_ID = (location.hostname === 'digipincode.pages.dev') ? 'G-99Z495K2T8' : 'G-30JK9GG08F';
    gtag('config', GA_ID);
  </script>
  <meta name="google-site-verification" content="GlkDu5ZL-CyyKjwPSj9d9X3Y2qsHUj_qAwRwxiLr7nI" />
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta name="theme-color" content="#1e40af" />
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Digipincode" />
  <meta property="og:locale" content="en_IN" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={new URL(Astro.url.pathname, 'https://digipincode.india-in.workers.dev').href} />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta property="og:image" content="https://digipincode.india-in.workers.dev/og-image.png" />
  {/* ===== BLOCK:CANONICAL-CLEAN ===== strip query string; always point to canonical workers.dev host */}
  <link rel="canonical" href={new URL(Astro.url.pathname, 'https://digipincode.india-in.workers.dev').href} />
  <link rel="sitemap" href="/sitemap.xml" />
  <script type="application/ld+json" set:html={JSON.stringify(orgLd)} />
  <script type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", "@type": "WebSite", "name": "Digipincode", "url": "https://digipincode.india-in.workers.dev/" })} />
  <script is:inline src="https://analytics.ahrefs.com/analytics.js" data-key="gOliiXpzU4P4bK1z+5QfgA" async></script>
  <script>
    import { initFeedbackButtons } from '../components/FeedbackWidget';
    initFeedbackButtons();
  </script>
  <slot name="head" />
</head>
<body>
  <header class="site-head">
    <a class="brand" href="/"><span class="logo">📮</span> Digipincode</a>
    <nav aria-label="Main menu">
      {NAV_LINKS.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
  </header>
  <main>
    <div class="update-banner" role="note">
      <span class="ub-icon">🔄</span>
      <span><strong>Regularly updated & verified:</strong> we're continuously expanding this directory towards <strong>10 lakh+ (1 million+) unique, individually verified records</strong> — pincodes, villages, panchayats, LGD codes and post offices. Data is checked and validated on an ongoing basis, so keep visiting for the freshest information.</span>
    </div>
    <slot />
    <section class="facilities" aria-label="Facilities and basic details">
      <h2>Facilities & basic details</h2>
      <p class="intro">We are adding these details for every place in India, one by one. The information below is being collected from government records (Census 2011 and District Census Handbooks). Where a value is not collected yet, we clearly say so — we never fill guessed or wrong data. If you know a place well and something is missing or wrong, please tap the <strong>⚠️ Report an Issue</strong> button and tell us.</p>
      <div class="factgrid">
        {FACILITIES.map(([icon, label]) => (
          <div class="fact"><div class="k">{icon} {label}</div><div class="v collecting">{COLLECTING}</div></div>
        ))}
      </div>
    </section>
  </main>
  <footer class="site-foot">
    <nav class="linkfarm" aria-label="Popular pages">
      <h3>Popular right now</h3>
      <div class="lf-links">
        {POPULAR.map(([city, pin]) => <a href={`/pincode/${pin}`}>{city} {pin}</a>)}
        <a href="/states">All States</a>
        <a href="/search">Search</a>
        <a href="/saved">🔖 Saved pages</a>
      </div>
    </nav>
    <div class="footer-cols">
      <div>
        <p><strong>{SITE.name}</strong></p>
        <p class="muted">6 lakh villages, panchayats & pincodes of India — with LGD codes, census data and DIGIPIN.</p>
      </div>
      <div>
        <p><a href="/search">Search</a></p>
        <p><a href="/states">All States</a></p>
        <p><a href="/chhath/">Chhath 2026</a></p>
        <p><a href="/saved">Saved pages</a></p>
      </div>
      <div>
        {FOOTER_LINKS.map((l) => <p><a href={l.href}>{l.label}</a></p>)}
      </div>
    </div>
    <p class="muted">
      Page last updated <time datetime={FRESHNESS.codeUpdated}>{fmtDate(FRESHNESS.codeUpdated)}</time> ·
      India Post & LGD data verified <time datetime={FRESHNESS.dataVerified}>{fmtDate(FRESHNESS.dataVerified)}</time> ·
      directory online since <time datetime={FRESHNESS.firstPublished}>{fmtDate(FRESHNESS.firstPublished)}</time>
    </p>
    <p class="muted">© {new Date().getFullYear()} {SITE.name} · SKM Studio Network · Data: India Post & LGD Directory</p>
  </footer>
  <button id="save-page-btn" class="save-btn" type="button" title="Save this page to your favourites">🔖 Save</button>
  <script is:inline>
    (function () {
      var b = document.getElementById('save-page-btn');
      if (!b) return;
      var key = 'dpc-saved';
      var url = location.pathname;
      var title = document.title.replace(/\s*\|.*/, '');
      function get() { try { return JSON.parse(localStorage.getItem(key)) || []; } catch (e) { return []; } }
      function isSaved() { return get().some(function (x) { return x.url === url; }); }
      function render() { b.textContent = isSaved() ? '✓ Saved' : '🔖 Save'; b.setAttribute('aria-pressed', isSaved() ? 'true' : 'false'); }
      b.addEventListener('click', function () {
        var list = get();
        if (isSaved()) { list = list.filter(function (x) { return x.url !== url; }); }
        else { list.unshift({ url: url, title: title }); }
        try { localStorage.setItem(key, JSON.stringify(list.slice(0, 200))); } catch (e) {}
        render();
      });
      render();
    })();
  </script>
</body>
</html>

<style is:global>
  :root {
    --navy: #12263f; --blue: #1a5fb4; --accent: #e85d04;
    --bg: #f6f8fb; --line: #e3e8f0; --text: #1c2430; --muted: #5b6b7f;
    /* ---- Locked type scale (one scale for the whole site) ---- */
    --fs-h1: clamp(1.5rem, 4.6vw, 2.1rem);
    --fs-h2: clamp(1.2rem, 3.6vw, 1.5rem);
    --fs-h3: clamp(1.02rem, 2.8vw, 1.15rem);
    --fs-body: clamp(.95rem, 2.6vw, 1.05rem);
    --fs-small: .85rem;
    --fw-h1: 700; --fw-h2: 700; --fw-h3: 600; --fw-body: 400;
    --lh-h: 1.25; --lh-body: 1.65;
  }
  * { box-sizing: border-box; }
  body { font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif; max-width: 1020px; margin: 0 auto; padding: 0 .9rem 2rem; color: var(--text); background: var(--bg); line-height: 1.6; }
  a { color: var(--blue); }

  @keyframes fadeUp { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
  @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
  .hero { animation: fadeIn .45s ease both; }
  .card, .fact { animation: fadeUp .45s ease both; }
  .card:nth-child(2), .fact:nth-child(2) { animation-delay: .05s; }
  .card:nth-child(3), .fact:nth-child(3) { animation-delay: .1s; }
  .card:nth-child(4), .fact:nth-child(4) { animation-delay: .15s; }
  .card:nth-child(5), .fact:nth-child(5) { animation-delay: .2s; }
  .card:nth-child(n+6), .fact:nth-child(n+6) { animation-delay: .25s; }
  details.faq { animation: fadeUp .4s ease both; }
  details.faq:nth-child(2) { animation-delay: .06s; }
  details.faq:nth-child(3) { animation-delay: .12s; }
  details.faq:nth-child(n+4) { animation-delay: .18s; }
  .card { transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease; }
  .card:hover { transform: translateY(-3px); box-shadow: 0 6px 18px rgba(18,38,63,.12); border-left-color: var(--accent); }
  @media (prefers-reduced-motion: reduce) {
    .hero, .card, .fact, details.faq { animation: none; }
    .card { transition: none; }
  }

  .site-head { position: sticky; top: 0; z-index: 50; background: var(--navy); margin: 0 -.9rem; padding: .6rem .9rem; display: flex; flex-wrap: wrap; gap: .4rem 1rem; align-items: center; justify-content: space-between; box-shadow: 0 2px 10px rgba(18,38,63,.25); }
  .site-head .brand { color: #fff; font-weight: 700; font-size: 1.05rem; text-decoration: none; display: flex; align-items: center; gap: .4rem; }
  .site-head nav { display: flex; flex-wrap: wrap; gap: .15rem .3rem; }
  .site-head nav a { color: #cfe0f5; text-decoration: none; font-weight: 600; font-size: clamp(.8rem, 2.4vw, .9rem); padding: .35rem .65rem; border-radius: 7px; }
  .site-head nav a:hover { background: rgba(255,255,255,.12); color: #fff; }
  main { padding: 1rem 0 2rem; }

  .update-banner { display: flex; gap: .6rem; align-items: flex-start; background: linear-gradient(90deg, #e8f4ec, #eaf2fb); border: 1px solid #cfe6d8; border-left: 4px solid #2a9d8f; border-radius: 10px; padding: .7rem .9rem; margin: 0 0 1rem; font-size: clamp(.8rem, 2.6vw, .88rem); line-height: 1.55; color: var(--text); }
  .update-banner .ub-icon { font-size: 1.1rem; flex-shrink: 0; }

  .facilities { margin-top: 2.5rem; }
  .facilities .v.collecting { color: #8a6d3b; font-weight: 500; font-size: .82rem; line-height: 1.45; }

  .hero { background: linear-gradient(135deg, var(--navy), var(--blue)); color: #fff; border-radius: 16px; padding: clamp(1.2rem, 4vw, 2.2rem); margin: 1rem 0; }
  .hero h1 { color: #fff; font-size: var(--fs-h1); font-weight: var(--fw-h1); line-height: var(--lh-h); margin: 0 0 .4rem; }
  .hero .sub { color: #dbe6f5; font-size: clamp(.9rem, 2.6vw, 1.05rem); margin: 0; }
  .chips { display: flex; flex-wrap: wrap; gap: .4rem; margin-top: .8rem; }
  .chip { background: rgba(255,255,255,.14); border: 1px solid rgba(255,255,255,.28); color: #fff; padding: .22rem .75rem; border-radius: 999px; font-size: .8rem; }

  .breadcrumb { font-size: .85rem; color: var(--muted); margin: .9rem 0; }
  .breadcrumb a { color: var(--blue); }
  h1 { color: var(--navy); font-size: var(--fs-h1); font-weight: var(--fw-h1); line-height: var(--lh-h); margin: 0 0 .5rem; }
  h2 { color: var(--navy); font-size: var(--fs-h2); font-weight: var(--fw-h2); line-height: var(--lh-h); margin: 2rem 0 .6rem; }
  h3 { color: var(--navy); font-size: var(--fs-h3); font-weight: var(--fw-h3); line-height: var(--lh-h); margin: 1.4rem 0 .5rem; }
  p { line-height: var(--lh-body); }
  .intro { font-size: clamp(.95rem, 2.6vw, 1.05rem); line-height: 1.7; }

  .factgrid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: .7rem; margin: 1rem 0; }
  .fact { background: #fff; border: 1px solid var(--line); border-radius: 12px; padding: .7rem .9rem; }
  .fact .k { font-size: .72rem; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); }
  .fact .v { font-weight: 700; color: var(--navy); font-size: clamp(.92rem, 2.5vw, 1.02rem); word-break: break-word; }

  .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: .7rem; margin: 1rem 0; }
  .card { background: #fff; border: 1px solid var(--line); border-left: 4px solid var(--blue); border-radius: 12px; padding: .8rem 1rem; }
  .card a { font-weight: 600; text-decoration: none; }
  .card a:hover { text-decoration: underline; }
  .card .d { font-size: .85rem; color: var(--muted); margin: .25rem 0 0; }

  .tablewrap { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  table.details { width: 100%; border-collapse: collapse; background: #fff; font-size: .95rem; margin: 1rem 0; min-width: 460px; }
  table.details th { text-align: left; padding: .5rem .8rem; background: #eef3fa; color: var(--navy); border: 1px solid var(--line); white-space: nowrap; }
  table.details td { padding: .5rem .8rem; border: 1px solid var(--line); }

  details.faq { background: #fff; border: 1px solid var(--line); border-radius: 10px; margin: .5rem 0; overflow: hidden; }
  details.faq summary { cursor: pointer; font-weight: 600; padding: .8rem 1rem; color: var(--navy); list-style: none; display: flex; justify-content: space-between; gap: .5rem; }
  details.faq summary::-webkit-details-marker { display: none; }
  details.faq summary::after { content: '+'; font-size: 1.2rem; color: var(--blue); flex-shrink: 0; }
  details.faq[open] summary { border-bottom: 1px solid var(--line); background: #f2f6fc; }
  details.faq[open] summary::after { content: '−'; }
  details.faq p, details.faq div { padding: .75rem 1rem; margin: 0; }

  .share { display: flex; flex-wrap: wrap; gap: .5rem; align-items: center; margin: 1.4rem 0; }
  .share span.lbl { font-size: .85rem; color: var(--muted); font-weight: 600; }
  .share a, .share button { border: none; border-radius: 8px; padding: .5rem .95rem; font-size: .85rem; font-weight: 600; text-decoration: none; cursor: pointer; color: #fff; font-family: inherit; }
  .wa { background: #177d43; } .x { background: #111; } .fb { background: #145ab8; } .tg { background: #176f9c; } .cp { background: var(--muted); }

  .note { background: #fff7e8; border-left: 4px solid var(--accent); padding: .7rem 1rem; font-size: .88rem; border-radius: 0 10px 10px 0; margin: 1rem 0; }
  .updated { font-size: .8rem; color: var(--muted); margin-top: 2rem; }
  ul.plain { padding-left: 1.2rem; } ul.plain li { margin: .3rem 0; }

  .save-btn { position: fixed; bottom: 16px; left: 16px; z-index: 9998; border: none; border-radius: 8px; padding: 10px 14px; font-size: 14px; font-weight: 600; cursor: pointer; color: #fff; background: var(--blue); box-shadow: 0 2px 8px rgba(0,0,0,.25); font-family: system-ui, sans-serif; }
  .save-btn:hover { background: #14497e; }
  .save-btn[aria-pressed="true"] { background: #2a9d8f; }
  @media (max-width: 480px) { .save-btn { bottom: 10px; left: 10px; padding: 9px 12px; font-size: 13px; } }

  .linkfarm { margin: 1.6rem 0 .6rem; padding: 1rem; background: #fff; border: 1px solid var(--line); border-radius: 12px; }
  .linkfarm h3, .linkfarm h4 { margin: 0 0 .5rem; font-size: .95rem; color: var(--navy); }
  .lf-links { display: flex; flex-wrap: wrap; gap: .35rem .4rem; }
  .lf-links a { text-decoration: none; font-size: .82rem; padding: .28rem .6rem; background: #eef3fa; border-radius: 999px; color: var(--navy); border: 1px solid var(--line); }
  .lf-links a:hover { background: #dde9f7; border-color: var(--blue); }
  .site-foot .linkfarm { background: rgba(255,255,255,.06); border-color: rgba(255,255,255,.15); }
  .site-foot .linkfarm h3 { color: #cfe0f5; }
  .site-foot .lf-links a { background: rgba(255,255,255,.08); color: #cfe0f5; border-color: rgba(255,255,255,.15); }
  .site-foot .lf-links a:hover { background: rgba(255,255,255,.16); color: #fff; }

  .site-foot { background: var(--navy); color: #cfe0f5; margin: 2rem -.9rem -2rem; padding: 1.6rem 1rem 1.2rem; }
  .site-foot a { color: #fff; }
  .footer-cols { display: flex; flex-wrap: wrap; gap: 1.5rem 2.5rem; justify-content: space-between; }
  .footer-cols p { margin: .3rem 0; font-size: .9rem; }
  .site-foot .muted { color: #8fa8c7; font-size: .8rem; }
</style>
