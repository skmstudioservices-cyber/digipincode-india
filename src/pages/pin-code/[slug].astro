---
import Layout from '../../layouts/Base.astro';
import { LOCALITIES, titleCase } from '../../data/localities.js';
// Locality "X Pin Code" landing pages (B10b) — built from real blogspot data.
// Data is a static import, so these pages read ZERO rows from D1.
export const prerender = false;

const { slug } = Astro.params;
const loc = LOCALITIES.find((l) => l.slug === slug);
if (!loc) return Astro.redirect('/404');

const name = titleCase(loc.slug);
const pin = loc.pin;
const BASE = 'https://digipincode.india-in.workers.dev';
const url = `${BASE}/pin-code/${slug}/`;

// Nearby localities sharing the same 6-digit prefix (same city cluster).
const nearby = LOCALITIES.filter((l) => l.slug !== slug && l.pin.slice(0, 3) === pin.slice(0, 3)).slice(0, 12);

const faq = [
  [`What is the pin code of ${name}?`, `The pin code (postal code) of ${name} is ${pin}.`],
  [`Which area does pin code ${pin} cover?`, `${pin} is the postal code for ${name} and its surrounding delivery area. Open the pincode ${pin} page for the full post-office details.`],
  [`How do I write an address with pin code ${pin}?`, `Write it in the standard format: recipient name, ${name}, PIN ${pin}, India.`],
];
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) };
const placeLd = {
  '@context': 'https://schema.org', '@type': 'Place', '@id': url, name: `${name} — Pin Code ${pin}`, url,
  address: { '@type': 'PostalAddress', addressLocality: name, addressCountry: 'IN', postalCode: pin },
};
const crumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${BASE}/` },
    { '@type': 'ListItem', position: 2, name: 'Pin codes by area', item: `${BASE}/states` },
    { '@type': 'ListItem', position: 3, name: `${name} pin code`, item: url },
  ],
};
---
<Layout
  title={`${name} Pin Code — ${pin} | Post Office, Area & Address Details`}
  description={`${name} pin code is ${pin}. Post office, delivery area, nearby localities and how to write an address with PIN ${pin}.`}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(placeLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(crumbLd)} />
  </Fragment>

  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a> › <a href="/states">States</a> › {name} pin code
  </nav>

  <section class="hero">
    <h1>📮 {name} Pin Code — {pin}</h1>
    <p class="sub">Postal code, post office and address details for {name}.</p>
    <div class="chips">
      <span class="chip">📮 PIN {pin}</span>
      <span class="chip">📍 {name}</span>
    </div>
  </section>

  <p class="intro">
    The pin code of <strong>{name}</strong> is <strong>{pin}</strong>. This is the postal index number used to route mail
    to {name} and its surrounding delivery area. For the full post-office profile — office type, delivery status and
    the villages served — open the <a href={`/pincode/${pin}/`}>pincode {pin} page</a>.
  </p>

  <h2>How to use pin code {pin}</h2>
  <div class="factgrid">
    <div class="fact"><div class="k">Locality</div><div class="v">{name}</div></div>
    <div class="fact"><div class="k">Pin code</div><div class="v">{pin}</div></div>
    <div class="fact"><div class="k">Post office page</div><div class="v"><a href={`/pincode/${pin}/`}>Pincode {pin}</a></div></div>
  </div>

  <h2>Nearby localities with pin code {pin.slice(0, 3)}xxx</h2>
  <div class="cards">
    {nearby.map((l) => (
      <div class="card"><a href={`/pin-code/${l.slug}/`}>{titleCase(l.slug)} Pin Code</a><p class="d">📮 {l.pin}</p></div>
    ))}
  </div>

  <h2>Frequently asked questions</h2>
  {faq.map(([q, a]) => (
    <details class="faq"><summary>{q}</summary><p>{a}</p></details>
  ))}

  <p class="updated">Looking for another area? <a href="/states">Browse pin codes by state</a>.</p>
</Layout>
