---
// Legacy URL /pincode/{p} → 301 → /{state}/district-{d}/pincode-{p}
import { pincodeUrl } from '../../lib/urls';
import { getPincode } from '../../lib/db';
export const prerender = false;
const { pincode } = Astro.params;
const data = await getPincode(Astro.locals.runtime.env.DB, pincode);
if (!data) return Astro.redirect('/404');
return Astro.redirect(pincodeUrl(data.state_slug, data.district_slug, pincode), 301);
---
