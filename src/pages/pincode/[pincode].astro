---
import Layout from '../../layouts/Base.astro';
// Pincode page — the money page. SSR from D1.
export const prerender = false;
import { getPincode, getVillagesByPincode, getPanchayatsByPincode } from '../../lib/db';

const { pincode } = Astro.params;
const data = await getPincode(Astro.locals.runtime.env.DB, pincode);
if (!data) return Astro.redirect('/404');

const villages = await getVillagesByPincode(Astro.locals.runtime.env.DB, pincode);
const panchayats = await getPanchayatsByPincode(Astro.locals.runtime.env.DB, pincode);

const BASE = 'https://digipincode.india-in.workers.dev';
const url = `${BASE}/pincode/${pincode}`;
const villageNames = villages.slice(0, 5).map(v => v.name).join(', ');
const faq = [
  [`What is pincode ${pincode}?`, `Pincode ${pincode} is the postal code of the ${data.office_name} post office (${data.office_type}) in ${data.district_name} district, ${data.state_name}. It is a ${String(data.delivery).toLowerCase().includes('delivery') ? 'delivery' : 'non-delivery'} post office under the ${data.division} division.`],
  [`Which district and state does pincode ${pincode} belong to?`, `Pincode ${pincode} belongs to ${data.district_name} district in ${data.state_name}. The taluk for this pincode is ${data.taluk}.`],
  [`Which villages come under pincode ${pincode}?`, villages.length ? `Pincode ${pincode} covers ${villages.length} village${villages.length > 1 ? 's' : ''}, including ${villageNames}${villages.length > 5 ? ` and ${villages.length - 5} more` : ''}.` : `No villages are mapped to pincode ${pincode} in our directory yet — it mainly serves the post office area.`],
  [`How do I write an address with pincode ${pincode}?`, `Write it in the standard format: recipient name, ${data.office_name}, ${data.taluk}, ${data.district_name}, ${data.state_name} — PIN ${pincode}.`],
  [`Is ${data.office_name} a delivery post office?`, `${data.office_name} is a ${data.office_type} office with delivery status: ${data.delivery}.`],
];
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) };
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${BASE}/` },
    { '@type': 'ListItem', position: 2, name: data.state_name, item: `${BASE}/state/${data.state_slug}` },
    { '@type': 'ListItem', position: 3, name: data.district_name, item: `${BASE}/state/${data.state_slug}/${data.district_slug}` },
    { '@type': 'ListItem', position: 4, name: `Pincode ${pincode}` },
  ],
};
const shareUrl = encodeURIComponent(url);
const shareText = encodeURIComponent(`Pincode ${pincode} — ${data.office_name}, ${data.district_name}, ${data.state_name}`);
---
<Layout
  title={`Pincode ${pincode} — ${data.office_name}, ${data.district_name}, ${data.state_name} | Villages & Post Office`}
  description={`Pincode ${pincode}: ${data.office_name} (${data.office_type}), ${data.taluk}, ${data.district_name}, ${data.state_name}. Full list of villages, panchayats and post office details for pincode ${pincode}.`}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  </Fragment>

  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a> ›
    <a href={`/state/${data.state_slug}`}>{data.state_name}</a> ›
    <a href={`/state/${data.state_slug}/${data.district_slug}`}>{data.district_name}</a> ›
    Pincode {pincode}
  </nav>

  <section class="hero">
    <h1>Pincode {pincode} — {data.office_name}</h1>
    <p class="sub">{data.office_type} post office in {data.taluk}, {data.district_name} district, {data.state_name}. Delivery status: {data.delivery}.</p>
    <div class="chips">
      <span class="chip">📮 {data.office_type}</span>
      <span class="chip">🗺️ {data.district_name}</span>
      <span class="chip">🚚 {data.delivery}</span>
      <span class="chip">{villages.length} villages</span>
      {panchayats.length > 0 && <span class="chip">{panchayats.length} panchayats</span>}
    </div>
  </section>

  <p class="intro">
    <strong>Pincode {pincode}</strong> is the postal index number for <strong>{data.office_name}</strong> and the surrounding area in {data.taluk}, {data.district_name} district of {data.state_name}.
    It falls under the {data.division} division, {data.region} region and the {data.circle} postal circle.
    {villages.length > 0 ? `This pincode serves ${villages.length} village${villages.length > 1 ? 's' : ''} and ${panchayats.length} panchayat${panchayats.length === 1 ? '' : 's'}.` : `Use it on all postal addresses for this post office area.`}
  </p>

  <div class="factgrid">
    <div class="fact"><div class="k">Post Office</div><div class="v">{data.office_name}</div></div>
    <div class="fact"><div class="k">Office Type</div><div class="v">{data.office_type}</div></div>
    <div class="fact"><div class="k">State</div><div class="v">{data.state_name}</div></div>
    <div class="fact"><div class="k">District</div><div class="v">{data.district_name}</div></div>
    <div class="fact"><div class="k">Taluk</div><div class="v">{data.taluk}</div></div>
    <div class="fact"><div class="k">Division</div><div class="v">{data.division}</div></div>
    <div class="fact"><div class="k">Region</div><div class="v">{data.region}</div></div>
    <div class="fact"><div class="k">Delivery</div><div class="v">{data.delivery}</div></div>
  </div>

  <h2>How to write a {pincode} address</h2>
  <div class="tablewrap">
    <table class="details">
      <tr><th>Line</th><th>Example</th></tr>
      <tr><td>Recipient</td><td>Shri/Smt <Full Name></td></tr>
      <tr><td>Post Office</td><td>{data.office_name}</td></tr>
      <tr><td>Taluk / District</td><td>{data.taluk}, {data.district_name}</td></tr>
      <tr><td>State — PIN</td><td>{data.state_name} — {pincode}</td></tr>
    </table>
  </div>

  {villages.length > 0 && (
    <>
      <h2>Villages under pincode {pincode}</h2>
      <div class="cards">
        {villages.map(v => (
          <div class="card">
            <a href={`/village/${v.slug}`}>{v.name}</a>
            {v.ai_description && <p class="d">{v.ai_description}</p>}
          </div>
        ))}
      </div>
    </>
  )}

  {panchayats.length > 0 && (
    <>
      <h2>Panchayats under pincode {pincode}</h2>
      <div class="cards">
        {panchayats.map(p => (
          <div class="card">
            <a href={`/panchayat/${p.lgd_code}`}>{p.local_body_name}</a>
          </div>
        ))}
      </div>
    </>
  )}

  <h2>Frequently asked questions</h2>
  {faq.map(([q, a]) => (
    <details class="faq">
      <summary>{q}</summary>
      <p>{a}</p>
    </details>
  ))}

  <div class="share">
    <span class="lbl">Share:</span>
    <a class="wa" href={`https://wa.me/?text=${shareText}%20${shareUrl}`} target="_blank" rel="noopener">WhatsApp</a>
    <a class="fb" href={`https://www.facebook.com/sharer/sharer.php?u=${shareUrl}`} target="_blank" rel="noopener">Facebook</a>
    <a class="x" href={`https://twitter.com/intent/tweet?url=${shareUrl}&text=${shareText}`} target="_blank" rel="noopener">X</a>
    <a class="tg" href={`https://t.me/share/url?url=${shareUrl}&text=${shareText}`} target="_blank" rel="noopener">Telegram</a>
    <button class="cp" onclick={`navigator.clipboard.writeText('${url}');this.textContent='Copied!'`}>Copy link</button>
  </div>

  <p class="note">Data sourced from the India Post pincode directory and the Local Government Directory (LGD). Postal boundaries occasionally change — verify critical mail details on the official India Post site.</p>
  <p class="updated">✅ Data verified September 2026 · <a href={`/state/${data.state_slug}`}>More pincode pages in {data.state_name}</a></p>
</Layout>
