---
import Layout from '../../layouts/Base.astro';
// Village page — SSR from D1, includes LGD panchayat + AI description + DIGIPIN
export const prerender = false;
import { getVillageBySlug, getPanchayatByVillage } from '../../lib/db';

const { slug } = Astro.params;
const village = await getVillageBySlug(Astro.locals.runtime.env.DB, slug);
if (!village) return Astro.redirect('/404');

const panchayat = await getPanchayatByVillage(Astro.locals.runtime.env.DB, village.lgd_code);

const BASE = 'https://digipincode.india-in.workers.dev';
const url = `${BASE}/village/${village.slug}`;
const where = panchayat ? `${panchayat.district_name}, ${panchayat.state_name}` : 'India';
const faq = [
  [`What is the pincode of ${village.name}?`, `The pincode of ${village.name} is ${village.pincode}.${panchayat ? ` It falls under ${panchayat.district_name} district, ${panchayat.state_name}.` : ''}`],
  [`Which panchayat does ${village.name} belong to?`, panchayat ? `${village.name} is administered by ${panchayat.local_body_name} (LGD code ${panchayat.lgd_code}) in ${panchayat.block_name} block.` : `${village.name}'s panchayat details are being verified.`],
  [`What is the population of ${village.name}?`, village.population ? `As per census data, ${village.name} has a population of ${village.population.toLocaleString('en-IN')} living in ${village.households?.toLocaleString('en-IN') ?? '—'} households.` : `Population data for ${village.name} is not available in the current census extract.`],
  [`What is the DIGIPIN of ${village.name}?`, `DIGIPIN is India Post's digital address system — a 10-character code that identifies any location in India. ${village.digipin ? `${village.name}'s DIGIPIN is ${village.digipin}.` : 'A DIGIPIN for this village has not been assigned yet.'}`],
  [`What is the LGD code of ${village.name}?`, `The Local Government Directory (LGD) code of ${village.name} is ${village.lgd_code}, and its census code is ${village.census_code}.`],
];
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) };
const breadcrumb = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${BASE}/` },
    { '@type': 'ListItem', position: 2, name: 'Villages', item: `${BASE}/states` },
    { '@type': 'ListItem', position: 3, name: village.name },
  ],
};
const shareUrl = encodeURIComponent(url);
const shareText = encodeURIComponent(`${village.name} — Pincode ${village.pincode}${panchayat ? `, ${panchayat.district_name}` : ''}`);
---
<Layout
  title={`${village.name} Village — Pincode ${village.pincode}, ${where} | Population & Panchayat`}
  description={`${village.name} village pincode ${village.pincode} in ${where}. Population, households, LGD code, census code, DIGIPIN, panchayat and full village profile.`}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  </Fragment>

  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a> › <a href="/states">Villages</a> › {village.name}
  </nav>

  <section class="hero">
    <h1>🏘️ {village.name}</h1>
    <p class="sub">Village in {where} · Pincode <strong>{village.pincode}</strong></p>
    <div class="chips">
      <span class="chip">📍 {where}</span>
      <span class="chip">📮 {village.pincode}</span>
      {village.population && <span class="chip">👥 {village.population.toLocaleString('en-IN')}</span>}
      {village.digipin && <span class="chip">🛰️ DIGIPIN</span>}
    </div>
  </section>

  <p class="intro">
    <strong>{village.name}</strong> is a village in {where} with the postal pincode <strong>{village.pincode}</strong>.
    {village.population ? ` It is home to about ${village.population.toLocaleString('en-IN')} people across ${village.households?.toLocaleString('en-IN') ?? '—'} households.` : ''}
    {panchayat ? ` The village is administered by ${panchayat.local_body_name} in ${panchayat.block_name} block.` : ''}
  </p>

  {village.ai_description && <p class="intro">{village.ai_description}</p>}

  <div class="factgrid">
    <div class="fact"><div class="k">Pincode</div><div class="v"><a href={`/pincode/${village.pincode}`}>{village.pincode}</a></div></div>
    <div class="fact"><div class="k">LGD Code</div><div class="v">{village.lgd_code}</div></div>
    <div class="fact"><div class="k">Census Code</div><div class="v">{village.census_code}</div></div>
    <div class="fact"><div class="k">Population</div><div class="v">{village.population?.toLocaleString('en-IN') ?? '—'}</div></div>
    <div class="fact"><div class="k">Households</div><div class="v">{village.households?.toLocaleString('en-IN') ?? '—'}</div></div>
    {village.digipin && <div class="fact"><div class="k">DIGIPIN</div><div class="v">{village.digipin}</div></div>}
  </div>

  {village.lat && village.lon && (
    <div class="tablewrap">
      <table class="details">
        <tr><th>Latitude</th><td>{village.lat}</td></tr>
        <tr><th>Longitude</th><td>{village.lon}</td></tr>
      </table>
    </div>
  )}

  {panchayat && (
    <>
      <h2>Panchayat administration</h2>
      <div class="cards">
        <div class="card">
          <a href={`/panchayat/${panchayat.lgd_code}`}>{panchayat.local_body_name}</a>
          <p class="d">{panchayat.local_body_type} · {panchayat.block_name} block · LGD {panchayat.lgd_code}</p>
        </div>
      </div>
    </>
  )}

  <h2>Postal details</h2>
  <p class="intro">All mail and packages for {village.name} are delivered via the post office serving pincode <a href={`/pincode/${village.pincode}`}>{village.pincode}</a>. Always write the pincode in the last line of the address for fastest delivery.</p>

  <h2>Frequently asked questions</h2>
  {faq.map(([q, a]) => (
    <details class="faq">
      <summary>{q}</summary>
      <p>{a}</p>
    </details>
  ))}

  <div class="share">
    <span class="lbl">Share:</span>
    <a class="wa" href={`https://wa.me/?text=${shareText}%20${shareUrl}`} target="_blank" rel="noopener">WhatsApp</a>
    <a class="fb" href={`https://www.facebook.com/sharer/sharer.php?u=${shareUrl}`} target="_blank" rel="noopener">Facebook</a>
    <a class="x" href={`https://twitter.com/intent/tweet?url=${shareUrl}&text=${shareText}`} target="_blank" rel="noopener">X</a>
    <a class="tg" href={`https://t.me/share/url?url=${shareUrl}&text=${shareText}`} target="_blank" rel="noopener">Telegram</a>
    <button class="cp" onclick={`navigator.clipboard.writeText('${url}');this.textContent='Copied!'`}>Copy link</button>
  </div>

  <p class="note">Village data from the Census of India and the Local Government Directory (LGD). DIGIPIN codes from India Post's beta rollout.</p>
  <p class="updated">✅ Data verified September 2026</p>
</Layout>
