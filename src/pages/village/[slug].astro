---
import Layout from '../../layouts/Base.astro';
// Village page v3 — THICK: full state › district › tehsil › panchayat › post-office hierarchy on every page
export const prerender = false;
import { getVillageBySlug, getPanchayatByVillage, getPincode, getSiblingVillages, getSubdistrictVillageStats } from '../../lib/db';

const { slug } = Astro.params;
const village = await getVillageBySlug(Astro.locals.runtime.env.DB, slug);
if (!village) return Astro.redirect('/404');

const panchayat = await getPanchayatByVillage(Astro.locals.runtime.env.DB, village.lgd_code);
const office = village.pincode ? await getPincode(Astro.locals.runtime.env.DB, village.pincode) : null;
const siblings = village.sub_district_id ? await getSiblingVillages(Astro.locals.runtime.env.DB, village.sub_district_id, village.slug, 12) : [];
const stats = village.sub_district_id ? await getSubdistrictVillageStats(Astro.locals.runtime.env.DB, village.sub_district_id) : null;

const stateName = village.state_name || (panchayat && panchayat.state_name) || 'India';
const districtName = village.district_name || (panchayat && panchayat.district_name) || '';
const tehsilName = village.sub_district_name || (office && office.taluk) || '';
const stateSlug = village.state_slug || '';
const districtSlug = village.district_slug || '';
const tehsilSlug = village.sub_district_slug || '';
const where = districtName ? `${districtName}, ${stateName}` : stateName;
const tehsilVillages = stats?.village_count ?? 0;

// Village facilities — verified-value slots. amen.* will be filled from the
// Census 2011 Village Directory / DCHB import; until then each field shows a
// transparent collection status instead of an empty or invented value.
const amen = (village as any).amenities || null;
const facilities = [
  ['🛣️ Road & approach', amen?.road_type ?? 'Aggregating — road type being verified from Census 2011 Village Directory'],
  ['🚰 Drinking water', amen?.water_source ?? 'Collecting — primary water source from verified census records'],
  ['⚡ Electricity', amen?.electricity ?? 'Collecting — domestic power supply status from verified records'],
  ['🏫 Schools', amen?.schools ?? 'Aggregating — pre-primary/senior-secondary data from verified records'],
  ['🏥 Medical facility', amen?.medical ?? 'Aggregating — nearest health facility data from verified records'],
  ['🚌 Bus stop', amen?.bus_stop ?? 'Collecting — nearest bus stop / transport point from verified sources'],
  ['🚆 Railway station', amen?.rail_station ?? 'Collecting — nearest railway station & distance from verified sources'],
  ['📶 Mobile coverage', amen?.mobile ?? 'Aggregating — network coverage status from verified records'],
  ['🏦 Banking', amen?.bank ?? 'Aggregating — banking & credit society data from verified records'],
  ['⭐ Known for', amen?.famous_for ?? 'Collecting — local highlights are being compiled from user reports & verified sources'],
];

const BASE = 'https://digipincode.india-in.workers.dev';
const url = `${BASE}/village/${village.slug}`;
const faq = [
  [`What is the pincode of ${village.name}?`, `The pincode of ${village.name} is ${village.pincode}.${office ? ` It is served by the ${office.office_name} post office (${office.office_type}) in ${office.taluk}, ${districtName} district.` : districtName ? ` It falls under ${districtName} district, ${stateName}.` : ''}`],
  [`Which district and state does ${village.name} belong to?`, districtName ? `${village.name} is a village in ${tehsilName ? `${tehsilName} tehsil of ` : ''}${districtName} district, ${stateName}${tehsilVillages ? ` — one of ${tehsilVillages} villages in ${tehsilName} tehsil` : ''}.` : `${village.name} is located in ${stateName}.`],
  [`Which panchayat does ${village.name} belong to?`, panchayat ? `${village.name} is administered by ${panchayat.local_body_name} (a ${panchayat.local_body_type}, LGD code ${panchayat.lgd_code}) in ${panchayat.block_name} block.${panchayat.population ? ` The panchayat serves a population of about ${panchayat.population.toLocaleString('en-IN')}.` : ''}` : `Panchayat details for ${village.name} are being verified.`],
  [`What is the population of ${village.name}?`, village.population ? `As per census data, ${village.name} has a population of ${village.population.toLocaleString('en-IN')} living in ${village.households?.toLocaleString('en-IN') ?? '—'} households.` : `Population data for ${village.name} is not available in the current census extract.`],
  [`What is the DIGIPIN of ${village.name}?`, `DIGIPIN is India Post's digital address system — a 10-character code that identifies any location in India. ${village.digipin ? `${village.name}'s DIGIPIN is ${village.digipin}.` : 'A DIGIPIN for this village has not been assigned yet.'}`],
  [`What are the LGD and census codes of ${village.name}?`, `The Local Government Directory (LGD) code of ${village.name} is ${village.lgd_code ?? '—'}, and its census code is ${village.census_code ?? '—'}.`],
];
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) };
const breadcrumb = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${BASE}/` },
    ...(stateSlug ? [{ '@type': 'ListItem', position: 2, name: stateName, item: `${BASE}/state/${stateSlug}` }] : []),
    ...(districtSlug ? [{ '@type': 'ListItem', position: 3, name: districtName, item: `${BASE}/state/${stateSlug}/${districtSlug}` }] : []),
    ...(tehsilSlug ? [{ '@type': 'ListItem', position: 4, name: tehsilName, item: `${BASE}/state/${stateSlug}/${districtSlug}/${tehsilSlug}` }] : []),
    { '@type': 'ListItem', position: stateSlug && districtSlug && tehsilSlug ? 5 : 2, name: village.name },
  ],
};
const shareUrl = encodeURIComponent(url);
const shareText = encodeURIComponent(`${village.name} village — Pincode ${village.pincode}, ${where}`);
---
<Layout
  title={`${village.name} Village — Pincode ${village.pincode}, ${tehsilName ? `${tehsilName} Tehsil, ` : ''}${where} | Population & Panchayat`}
  description={`${village.name} village (pincode ${village.pincode}) in ${tehsilName ? `${tehsilName} tehsil, ` : ''}${where}: population, households, panchayat, post office, facilities, LGD/census codes, DIGIPIN and full administrative profile.`}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  </Fragment>

  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a>
    {stateSlug && <>› <a href={`/state/${stateSlug}`}>{stateName}</a></>}
    {districtSlug && <>› <a href={`/state/${stateSlug}/${districtSlug}`}>{districtName}</a></>}
    {tehsilSlug && <>› <a href={`/state/${stateSlug}/${districtSlug}/${tehsilSlug}`}>{tehsilName}</a></>}
    › {village.name}
  </nav>

  <section class="hero">
    <h1>🏘️ {village.name}</h1>
    <p class="sub">Village in {tehsilName ? `${tehsilName} tehsil, ` : ''}{where} · Pincode <strong>{village.pincode}</strong></p>
    <div class="chips">
      <span class="chip">📍 {where}</span>
      <span class="chip">📮 {village.pincode}</span>
      {village.population && <span class="chip">👥 {village.population.toLocaleString('en-IN')}</span>}
      {tehsilVillages > 0 && <span class="chip">🗺️ {tehsilVillages} villages in {tehsilName || 'tehsil'}</span>}
      {village.digipin && <span class="chip">🛰️ DIGIPIN</span>}
    </div>
  </section>

  <p class="intro">
    <strong>{village.name}</strong> is a village in {tehsilName ? `${tehsilName} tehsil of ` : ''}<strong>{districtName || stateName}</strong>.
    {tehsilVillages > 1 ? `It is one of ${tehsilVillages} villages that make up ${tehsilName} tehsil.` : ''}
    {village.population ? ` Around ${village.population.toLocaleString('en-IN')} people live here in ${village.households?.toLocaleString('en-IN') ?? '—'} households.` : ''}
    Mail for the village is delivered under pincode <a href={`/pincode/${village.pincode}`}>{village.pincode}</a>.
  </p>

  {village.ai_description && <p class="intro">{village.ai_description}</p>}

  <h2>Administrative location of {village.name}</h2>
  <p class="intro">Every village in India sits inside a fixed administrative hierarchy — state › district › tehsil/taluk › panchayat — plus a postal zone. Here is the complete chain for {village.name}:</p>
  <div class="cards">
    {stateSlug && (
      <div class="card">
        <a href={`/state/${stateSlug}`}>{stateName}</a>
        <p class="d">State — all districts, villages & pincodes</p>
      </div>
    )}
    {districtSlug && (
      <div class="card">
        <a href={`/state/${stateSlug}/${districtSlug}`}>{districtName} District</a>
        <p class="d">District of {stateName} — sub-districts & villages</p>
      </div>
    )}
    {tehsilSlug && (
      <div class="card">
        <a href={`/state/${stateSlug}/${districtSlug}/${tehsilSlug}`}>{tehsilName} Tehsil</a>
        <p class="d">{tehsilVillages > 0 ? `${tehsilVillages} villages${stats?.total_population ? ` · ${stats.total_population.toLocaleString('en-IN')} people` : ''}` : 'Sub-district (tehsil/taluk)'}</p>
      </div>
    )}
    {panchayat && (
      <div class="card">
        <a href={`/panchayat/${panchayat.lgd_code}`}>{panchayat.local_body_name}</a>
        <p class="d">{panchayat.local_body_type} · {panchayat.block_name} block · LGD {panchayat.lgd_code}</p>
      </div>
    )}
    <div class="card">
      <a href={`/pincode/${village.pincode}`}>Pincode {village.pincode}</a>
      <p class="d">Postal zone{office ? ` · ${office.office_name}` : ''}</p>
    </div>
  </div>

  <h2>Village profile</h2>
  <div class="factgrid">
    <div class="fact"><div class="k">Pincode</div><div class="v"><a href={`/pincode/${village.pincode}`}>{village.pincode}</a></div></div>
    <div class="fact"><div class="k">District</div><div class="v">{districtName || '—'}</div></div>
    <div class="fact"><div class="k">Tehsil / Taluk</div><div class="v">{tehsilName || '—'}</div></div>
    <div class="fact"><div class="k">LGD Code</div><div class="v">{village.lgd_code ?? '—'}</div></div>
    <div class="fact"><div class="k">Census Code</div><div class="v">{village.census_code ?? '—'}</div></div>
    <div class="fact"><div class="k">Population</div><div class="v">{village.population?.toLocaleString('en-IN') ?? '—'}</div></div>
    <div class="fact"><div class="k">Households</div><div class="v">{village.households?.toLocaleString('en-IN') ?? '—'}</div></div>
    {village.digipin && <div class="fact"><div class="k">DIGIPIN</div><div class="v">{village.digipin}</div></div>}
    {village.lat && village.lon && <div class="fact"><div class="k">Coordinates</div><div class="v">{Number(village.lat).toFixed(3)}, {Number(village.lon).toFixed(3)}</div></div>}
  </div>

  {office && (
    <>
      <h2>Post office serving {village.name}</h2>
      <div class="factgrid">
        <div class="fact"><div class="k">Office</div><div class="v">{office.office_name}</div></div>
        <div class="fact"><div class="k">Type</div><div class="v">{office.office_type}</div></div>
        <div class="fact"><div class="k">Delivery</div><div class="v">{office.delivery}</div></div>
        <div class="fact"><div class="k">Division</div><div class="v">{office.division}</div></div>
        <div class="fact"><div class="k">Region</div><div class="v">{office.region}</div></div>
        <div class="fact"><div class="k">Circle</div><div class="v">{office.circle}</div></div>
      </div>
      <p class="intro">To address mail to {village.name}, write: recipient name, {village.name}, {office.taluk}, {districtName || office.district_name}, {stateName} — PIN <strong>{village.pincode}</strong>.</p>
    </>
  )}

  <h2>Village facilities & infrastructure</h2>
  <p class="intro">Infrastructure data for {village.name} is being aggregated from verified government records — Census 2011 Village Directory and District Census Handbooks. Fields below fill in as verification completes; found something that needs correcting? Use the ⚠️ <em>Report an Issue</em> button.</p>
  <div class="factgrid">
    {facilities.map(([label, value]) => (
      <div class="fact"><div class="k">{label}</div><div class="v">{value}</div></div>
    ))}
  </div>

  {siblings.length > 0 && (
    <>
      <h2>Other villages in {tehsilName || 'this tehsil'}</h2>
      <p class="intro">Villages near {village.name} within the same tehsil — useful for finding nearby pincodes and panchayats:</p>
      <div class="cards">
        {siblings.map(v => (
          <div class="card">
            <a href={`/village/${v.slug}`}>{v.name}</a>
            <p class="d">📮 {v.pincode}{v.population ? ` · 👥 ${v.population.toLocaleString('en-IN')}` : ''}</p>
          </div>
        ))}
      </div>
    </>
  )}

  <h2>Frequently asked questions</h2>
  {faq.map(([q, a]) => (
    <details class="faq">
      <summary>{q}</summary>
      <p>{a}</p>
    </details>
  ))}

  <div class="share">
    <span class="lbl">Share:</span>
    <a class="wa" href={`https://wa.me/?text=${shareText}%20${shareUrl}`} target="_blank" rel="noopener">WhatsApp</a>
    <a class="fb" href={`https://www.facebook.com/sharer/sharer.php?u=${shareUrl}`} target="_blank" rel="noopener">Facebook</a>
    <a class="x" href={`https://twitter.com/intent/tweet?url=${shareUrl}&text=${shareText}`} target="_blank" rel="noopener">X</a>
    <a class="tg" href={`https://t.me/share/url?url=${shareUrl}&text=${shareText}`} target="_blank" rel="noopener">Telegram</a>
    <button class="cp" onclick={`navigator.clipboard.writeText('${url}');this.textContent='Copied!'`}>Copy link</button>
  </div>

  <p class="note">Village data from the Census of India and the Local Government Directory (LGD). Postal data from India Post. Facility data is progressively verified from Census 2011 Village Directory / DCHB records.</p>
  <p class="updated">✅ Data verified September 2026{stateSlug ? ` · <a href="/state/${stateSlug}">More villages in ${stateName}</a>` : ''}</p>
</Layout>
