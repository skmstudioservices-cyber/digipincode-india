---
import Layout from '../../../layouts/Base.astro';
// District page v3 — THICK: village stats, sub-district counts, top villages, link farm
export const prerender = false;
import { getStateBySlug, getDistrictBySlug, getSubDistricts, getDistrictVillageStats, getTopVillagesByDistrict, getSubdistrictCountsByState } from '../../../lib/db';

const { slug, district } = Astro.params;
const state = await getStateBySlug(Astro.locals.runtime.env.DB, slug);
if (!state) return Astro.redirect('/404');
const dist = await getDistrictBySlug(Astro.locals.runtime.env.DB, state.id, district);
if (!dist) return Astro.redirect('/404');

const subDistricts = await getSubDistricts(Astro.locals.runtime.env.DB, dist.id);
// Non-critical enrichment — degrade gracefully instead of 500ing
let stats: any = null;
let topVillages: any[] = [];
try {
  stats = await getDistrictVillageStats(Astro.locals.runtime.env.DB, dist.id);
  topVillages = await getTopVillagesByDistrict(Astro.locals.runtime.env.DB, dist.id, 12);
} catch {}

const BASE = 'https://digipincode.india-in.workers.dev';
const url = `${BASE}/state/${state.slug}/${dist.slug}`;
const faq = [
  [`How many sub-districts are in ${dist.name}?`, `${dist.name} district in ${state.name} has ${subDistricts.length} sub-district${subDistricts.length === 1 ? '' : 's'} (tehsils/taluks) listed in our directory.`],
  [`How many villages are in ${dist.name} district?`, stats?.village_count ? `${dist.name} district covers ${stats.village_count.toLocaleString('en-IN')} villages${stats.total_population ? ` with a combined population of about ${stats.total_population.toLocaleString('en-IN')}` : ''}.` : `Pick a sub-district below to see every village with its pincode and population.`],
  [`How do I find a village in ${dist.name}?`, `Pick your sub-district below — every village page shows its pincode, population, LGD code, panchayat and post office.`],
];
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) };
const breadcrumb = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${BASE}/` },
    { '@type': 'ListItem', position: 2, name: state.name, item: `${BASE}/state/${state.slug}` },
    { '@type': 'ListItem', position: 3, name: dist.name, item: `${BASE}/state/${state.slug}/${dist.slug}` },
  ],
};
const shareUrl = encodeURIComponent(url);
const shareText = encodeURIComponent(`${dist.name} district — all pincodes & villages`);
---
<Layout
  title={`${dist.name} District, ${state.name} — All Pincodes, Sub-Districts & Villages`}
  description={`Complete ${dist.name} district pincode list: ${subDistricts.length} sub-districts, ${stats?.village_count ? stats.village_count.toLocaleString('en-IN') + ' villages' : 'villages'}, panchayats, post offices and LGD codes in ${state.name}.`}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  </Fragment>

  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a> › <a href={`/state/${state.slug}`}>{state.name}</a> › {dist.name}
  </nav>

  <section class="hero">
    <h1>{dist.name} District</h1>
    <p class="sub">{state.name} · {subDistricts.length} sub-districts{stats?.village_count ? ` · ${stats.village_count.toLocaleString('en-IN')} villages` : ''}{stats?.total_population ? ` · ${stats.total_population.toLocaleString('en-IN')} people` : ''}</p>
    <div class="chips">
      <span class="chip">🗺️ {subDistricts.length} sub-districts</span>
      {stats?.village_count && <span class="chip">🏘️ {stats.village_count.toLocaleString('en-IN')} villages</span>}
      {stats?.total_population && <span class="chip">👥 {stats.total_population.toLocaleString('en-IN')} people</span>}
      <span class="chip">📮 Pincode lookup</span>
    </div>
  </section>

  <p class="intro">
    <strong>{dist.name}</strong> is a district of {state.name}, organised into <strong>{subDistricts.length} sub-districts</strong> (tehsils/taluks).
    {stats?.village_count ? `It covers ${stats.village_count.toLocaleString('en-IN')} villages` : `Browse sub-districts below to reach every village`} — each with its own page showing pincode, population, LGD code, DIGIPIN, panchayat administration and post office details.
  </p>

  <h2>Sub-districts of {dist.name}</h2>
  <div class="cards">
    {subDistricts.map(sd => (
      <div class="card">
        <a href={`/state/${state.slug}/${dist.slug}/${sd.slug}`}>{sd.name}</a>
        <p class="d">Tehsil / Taluk — villages & pincodes</p>
      </div>
    ))}
  </div>

  {topVillages.length > 0 && (
    <>
      <h2>Largest villages in {dist.name}</h2>
      <p class="intro">The most populated villages of the district, by census data:</p>
      <div class="cards">
        {topVillages.map(v => (
          <div class="card">
            <a href={`/village/${v.slug}`}>{v.name}</a>
            <p class="d">📮 {v.pincode}{v.population ? ` · 👥 ${v.population.toLocaleString('en-IN')}` : ''}{v.lgd_code ? ` · LGD ${v.lgd_code}` : ''}</p>
          </div>
        ))}
      </div>
    </>
  )}

  <h2>Frequently asked questions</h2>
  {faq.map(([q, a]) => (
    <details class="faq">
      <summary>{q}</summary>
      <p>{a}</p>
    </details>
  ))}

  <div class="share">
    <span class="lbl">Share:</span>
    <a class="wa" href={`https://wa.me/?text=${shareText}%20${shareUrl}`} target="_blank" rel="noopener">WhatsApp</a>
    <a class="fb" href={`https://www.facebook.com/sharer/sharer.php?u=${shareUrl}`} target="_blank" rel="noopener">Facebook</a>
    <a class="x" href={`https://twitter.com/intent/tweet?url=${shareUrl}&text=${shareText}`} target="_blank" rel="noopener">X</a>
    <a class="tg" href={`https://t.me/share/url?url=${shareUrl}&text=${shareText}`} target="_blank" rel="noopener">Telegram</a>
    <button class="cp" onclick={`navigator.clipboard.writeText('${url}');this.textContent='Copied!'`}>Copy link</button>
  </div>

  <section class="linkfarm" aria-label="More in this district">
    <h3>Explore {dist.name}</h3>
    <div class="lf-links">
      {subDistricts.map(sd => <a href={`/state/${state.slug}/${dist.slug}/${sd.slug}`}>{sd.name}</a>)}
      <a href={`/state/${state.slug}`}>All districts of {state.name} ›</a>
    </div>
  </section>

  <p class="updated">✅ Data verified September 2026 · <a href={`/state/${state.slug}`}>More districts in {state.name}</a></p>
</Layout>
