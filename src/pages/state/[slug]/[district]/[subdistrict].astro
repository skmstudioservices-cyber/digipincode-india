---
// Legacy URL /state/{s}/{d}/{t} → 301 → /{s}/district-{d}/{tehsil|taluk}-{t}
import { subWord } from '../../../../lib/urls';
export const prerender = false;
const { slug, district, subdistrict } = Astro.params;
return Astro.redirect(`/${slug}/district-${district}/${subWord(slug)}-${subdistrict}`, 301);
---
