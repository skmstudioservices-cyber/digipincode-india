<script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
<script is:inline define:vars={{ GA_ID }}>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', GA_ID);
</script>
<script is:inline>
  // ===== Official India Post DIGIPIN algorithm (Annexure 1 & 3, DIGIPIN Technical Document) =====
  var GRID = [['F','C','9','8'],['J','3','2','7'],['K','4','5','6'],['L','M','P','T']];
  var MinLat = 2.5, MaxLat = 38.5, MinLon = 63.5, MaxLon = 99.5;

  function getDigipin(lat, lon) {
    if (lat < MinLat || lat > MaxLat) return '';
    if (lon < MinLon || lon > MaxLon) return '';
    var ml = MinLat, xl = MaxLat, mn = MinLon, xn = MaxLon, out = '';
    for (var lvl = 1; lvl <= 10; lvl++) {
      var lDiv = (xl - ml) / 4, nDiv = (xn - mn) / 4;
      var row = 0, col = 0;
      var nMax = xl, nMin = xl - lDiv;
      for (var x = 0; x < 4; x++) {
        if (lat >= nMin && lat < nMax) { row = x; break; }
        else { nMax = nMin; nMin = nMax - lDiv; }
      }
      var pMin = mn, pMax = mn + nDiv;
      for (var y = 0; y < 4; y++) {
        if (lon >= pMin && lon < pMax) { col = y; break; }
        else if ((pMin + nDiv) < xn) { pMin = pMax; pMax = pMin + nDiv; }
        else { col = y; }
      }
      out += GRID[row][col];
      if (lvl === 3 || lvl === 6) out += '-';
      ml = nMin; xl = nMax; mn = pMin; xn = pMax;
    }
    return out;
  }

  function getLatLng(vDigiPin) {
    vDigiPin = String(vDigiPin).replaceAll('-', '').toUpperCase();
    if (vDigiPin.length !== 10) return null;
    var ml = MinLat, xl = MaxLat, mn = MinLon, xn = MaxLon, Lat1, Lat2, Lng1, Lng2;
    for (var lvl = 0; lvl < 10; lvl++) {
      var ch = vDigiPin.charAt(lvl), ri = -1, ci = -1, f = 0;
      for (var r = 0; r < 4 && !f; r++) for (var c = 0; c < 4; c++) { if (GRID[r][c] === ch) { ri = r; ci = c; f = 1; break; } }
      if (!f) return null;
      var lDiv = (xl - ml) / 4, nDiv = (xn - mn) / 4;
      Lat1 = xl - (lDiv * (ri + 1)); Lat2 = xl - (lDiv * ri);
      Lng1 = mn + (nDiv * ci); Lng2 = mn + (nDiv * (ci + 1));
      ml = Lat1; xl = Lat2; mn = Lng1; xn = Lng2;
    }
    return { lat: (Lat2 + Lat1) / 2, lng: (Lng2 + Lng1) / 2 };
  }

  // ===== UI =====
  var map = L.map('map', { zoomControl: true }).setView([22.8, 79.2], 5);
  L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
    maxZoom: 19,
    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
  }).addTo(map);

  var marker = null;
  var $ = function (id) { return document.getElementById(id); };
  var currentCode = '';

  function fmtDm(v, isLat) {
    var d = Math.floor(Math.abs(v)), m = (Math.abs(v) - d) * 60;
    return d + '°' + m.toFixed(3) + '′' + (isLat ? (v >= 0 ? 'N' : 'S') : (v >= 0 ? 'E' : 'W'));
  }

  function showResult(label, code, meta) {
    $('result-label').textContent = label;
    $('result-code').textContent = code;
    $('result-meta').innerHTML = meta;
    $('result').classList.add('show');
    currentCode = code;
  }

  function handlePoint(latlng) {
    var code = getDigipin(latlng.lat, latlng.lng);
    var statusEl = $('status');
    if (!code) {
      statusEl.textContent = '⚠️ That location is outside India (DIGIPIN covers lat 2.5–38.5°N, lon 63.5–99.5°E only).';
      statusEl.style.color = '#b45309';
      return;
    }
    statusEl.textContent = '';
    statusEl.style.color = '';
    if (marker) map.removeLayer(marker);
    marker = L.marker(latlng).addTo(map);
    showResult('DIGIPIN for ' + latlng.lat.toFixed(5) + ', ' + latlng.lng.toFixed(5), code,
      'Approx. 3.8 m precision · ' + fmtDm(latlng.lat, true) + ' ' + fmtDm(latlng.lng, false));
    if (typeof gtag === 'function') gtag('event', 'digipin_generate');
  }

  map.on('click', function (e) { handlePoint(e.latlng); });

  $('locate-btn').addEventListener('click', function () {
    var btn = this;
    if (!navigator.geolocation) { $('status').textContent = 'Geolocation is not supported on this device.'; return; }
    btn.disabled = true; btn.textContent = 'Locating…';
    navigator.geolocation.getCurrentPosition(function (pos) {
      var ll = { lat: pos.coords.latitude, lng: pos.coords.longitude };
      map.setView(ll, 16);
      handlePoint(ll);
      btn.disabled = false; btn.textContent = '📍 Use My Current Location';
    }, function () {
      $('status').textContent = 'Could not get your location — please allow location access, or tap the map instead.';
      btn.disabled = false; btn.textContent = '📍 Use My Current Location';
    }, { enableHighAccuracy: true, timeout: 12000 });
  });

  function decode() {
    var val = $('code-input').value.trim();
    var res = getLatLng(val);
    if (!res) { $('status').textContent = '⚠️ Invalid DIGIPIN — expected 10 characters, e.g. 39J-438-TJC7 (symbols 2–9, C, F, J, K, L, M, P, T).'; $('status').style.color = '#b45309'; return; }
    $('status').textContent = ''; $('status').style.color = '';
    if (marker) map.removeLayer(marker);
    marker = L.marker([res.lat, res.lng]).addTo(map);
    map.setView([res.lat, res.lng], 16);
    showResult('Location of DIGIPIN ' + String(val).toUpperCase(), String(val).toUpperCase().replace(/(.{3})(.{3})(.{4})/, '$1-$2-$3'),
      fmtDm(res.lat, true) + ' ' + fmtDm(res.lng, false) + ' · centre of the ~3.8 m grid cell');
    if (typeof gtag === 'function') gtag('event', 'digipin_decode');
  }
  $('decode-btn').addEventListener('click', decode);
  $('code-input').addEventListener('keydown', function (e) { if (e.key === 'Enter') decode(); });

  $('copy-btn').addEventListener('click', function () {
    if (!currentCode) return;
    var done = (function () { this.textContent = '✅ Copied!'; var b = this; setTimeout(function () { b.textContent = '📋 Copy Code'; }, 1600); }).bind(this);
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(currentCode).then(done);
    } else {
      var ta = document.createElement('textarea'); ta.value = currentCode;
      document.body.appendChild(ta); ta.select();
      try { document.execCommand('copy'); done(); } catch (e) {}
      document.body.removeChild(ta);
    }
  });
</script>
</body>
</html>
