---
import Layout from '../layouts/Base.astro';

Astro.response.status = 404;
---
<Layout
  title="Page Not Found — Digipincode India"
  description="The page you are looking for does not exist. Browse all Indian states, districts, tehsils, villages and pincodes instead."
>
  <section class="hero">
    <h1>🔍 Page Not Found</h1>
    <p class="sub">The page you are looking for does not exist or has moved.</p>
    <div class="chips">
      <span class="chip">🏘️ 6 lakh villages</span>
      <span class="chip">📮 1.5 lakh+ pincodes</span>
    </div>
  </section>
  <p class="intro">Try searching for a pincode, village, district or panchayat instead:</p>
  <form action="/search" method="get" class="search" style="display:flex;gap:.5rem;flex-wrap:wrap;margin-bottom:1.5rem">
    <input type="search" name="q" placeholder="Search pincode, village, district…" style="flex:1;min-width:220px;padding:.7rem .9rem;border:1px solid var(--line);border-radius:10px;font-size:1rem" />
    <button type="submit" style="padding:.7rem 1.3rem;border:none;border-radius:10px;background:#fff;color:var(--navy);font-weight:700;cursor:pointer">Search</button>
  </form>
  <p>Or start from the <a href="/states">full list of Indian states</a> or the <a href="/">homepage</a>.</p>
</Layout>
