---
import Layout from '../../layouts/Base.astro';
import { chhathCities, chhathDates2026 } from '../../data/chhath';

export const prerender = false;

const q = Astro.url.searchParams.get('q')?.trim().toLowerCase() || '';
const filtered = q
  ? chhathCities.filter((c) =>
      c.name.toLowerCase().includes(q) ||
      c.state.toLowerCase().includes(q) ||
      c.water.toLowerCase().includes(q))
  : chhathCities;

const byState = filtered.reduce<Record<string, typeof chhathCities>>((acc, c) => {
  (acc[c.state] ??= []).push(c);
  return acc;
}, {});

const title = 'Chhath Puja 2026 Ghats — Complete Ghat List for 39 Indian Cities (13-16 Nov)';
const description =
  'Chhath Puja 2026 dates (13-16 November) and the complete list of Chhath ghats in 39 cities — Patna, Delhi, Varanasi, Lucknow, Mumbai, Bengaluru, Hyderabad, Guwahati, Jaipur and more — rivers, ponds, lakes, beaches and administration advisories.';
---

<Layout title={title} description={description}>
  <section class="hero">
    <h1>Chhath Puja 2026 — Ghat Directory</h1>
    <p>
      Chhath Puja 2026 will be celebrated from <strong>13 to 16 November 2026</strong>.
      Find the major Chhath ghats, ponds, lakes and beaches in {chhathCities.length} cities across India —
      with arghya timings for each city.
    </p>
    <form action="/chhath/" method="get" class="csearch">
      <input type="search" name="q" placeholder="Search city, state or river — e.g. Patna, Bihar, Ganga" value={q} />
      <button type="submit">Find Ghats</button>
    </form>
  </section>

  <section class="dates">
    <h2>Chhath Puja 2026 Dates</h2>
    <table>
      <thead><tr><th>Day</th><th>Ritual</th><th>Date</th></tr></thead>
      <tbody>
        {chhathDates2026.map((d) => (
          <tr><td>{d.day}</td><td>{d.ritual}</td><td><strong>{d.date}</strong></td></tr>
        ))}
      </tbody>
    </table>
  </section>

  <section class="cities">
    <h2>{q ? `Search Results (${filtered.length})` : 'Chhath Ghats by City'}</h2>
    {q && filtered.length === 0 && <p>No cities found matching "{q}" — try a city, state or river name.</p>}
    {Object.entries(byState).map(([state, cities]) => (
      <div class="state-block">
        <h3>{state}</h3>
        <ul>
          {cities.map((c) => (
            <li>
              <a href={`/chhath/${c.slug}`}>Chhath Puja Ghats in {c.name}</a>
              <span class="muted"> — {c.ghats.length}+ sites on the {c.water}</span>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>

  <section class="note">
    <h2>Disclaimer</h2>
    <p>
      Ghat lists are compiled from district administration advisories and news reports from the
      2024-25 festival seasons. Municipal lists change every year (some ghats are declared unsafe
      and banned) — always confirm with the latest local administration advisory before the festival.
    </p>
  </section>
</Layout>

<style>
  .hero { text-align: center; padding: 2rem 1rem 1rem; }
  .csearch { margin: 1rem auto; max-width: 520px; display: flex; gap: .5rem; }
  .csearch input { padding: .6rem; flex: 1; }
  .csearch button { padding: .6rem 1.2rem; }
  .dates { padding: 1rem; }
  table { border-collapse: collapse; width: 100%; max-width: 640px; margin: 0 auto; }
  th, td { border: 1px solid #ddd; padding: .5rem .75rem; text-align: left; }
  th { background: #f5f5f5; }
  .cities { padding: 1rem; }
  .state-block { margin: 1rem 0; }
  .state-block ul { list-style: none; padding: 0; columns: 2; }
  .state-block li { padding: .3rem 0; }
  .muted { color: #666; font-size: .9em; }
  .note { padding: 1rem; max-width: 720px; margin: 0 auto; }
  @media (max-width: 600px) { .state-block ul { columns: 1; } }
</style>
