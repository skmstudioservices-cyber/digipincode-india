---
import Layout from '../../layouts/Base.astro';
import { chhathCities, chhathDates2026 } from '../../data/chhath';

export const prerender = false;

const { city: citySlug } = Astro.params;
const city = chhathCities.find((c) => c.slug === citySlug);
if (!city) return Astro.redirect('/chhath/');

const BASE = 'https://digipincode.india-in.workers.dev';
const others = chhathCities.filter((c) => c.slug !== city.slug);

// --- Arghya timings: sunrise/sunset computed from city coordinates (NOAA sunrise equation) ---
function solarEventIST(dateStr: string, lat: number, lon: number, sunset: boolean): string {
  const rad = Math.PI / 180;
  const d = new Date(dateStr + 'T12:00:00Z');
  const n = Math.round((d.getTime() - Date.UTC(2000, 0, 1, 12)) / 86400000);
  const Jstar = n - lon / 360; // days since J2000.0, adjusted for longitude
  const M = (357.5291 + 0.98560028 * Jstar) % 360; // mean anomaly
  const C = 1.9148 * Math.sin(M * rad) + 0.02 * Math.sin(2 * M * rad) + 0.0003 * Math.sin(3 * M * rad); // equation of center
  const lambda = (M + C + 180 + 102.9372) % 360; // ecliptic longitude
  const Jtransit =
    Date.UTC(2000, 0, 1, 12) +
    (Jstar + 0.0053 * Math.sin(M * rad) - 0.0069 * Math.sin(2 * lambda * rad)) * 86400000; // solar noon
  const delta = Math.asin(Math.sin(lambda * rad) * Math.sin(23.44 * rad)); // declination
  const cosOmega =
    (Math.sin(-0.83 * rad) - Math.sin(lat * rad) * Math.sin(delta)) /
    (Math.cos(lat * rad) * Math.cos(delta));
  if (cosOmega > 1 || cosOmega < -1) return '—';
  const omega = Math.acos(cosOmega) / rad; // hour angle
  const eventUTC = Jtransit + (sunset ? 1 : -1) * omega * 4 * 60000;
  const ist = new Date(eventUTC + 5.5 * 3600000);
  let h = ist.getUTCHours();
  const m = ist.getUTCMinutes();
  const ampm = h >= 12 ? 'PM' : 'AM';
  h = h % 12 || 12;
  return `${h}:${String(m).padStart(2, '0')} ${ampm} IST`;
}
const sunset15 = solarEventIST('2026-11-15', city.lat, city.lon, true);
const sunrise16 = solarEventIST('2026-11-16', city.lat, city.lon, false);

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Event',
      name: `Chhath Puja 2026 — ${city.name}`,
      startDate: '2026-11-15',
      endDate: '2026-11-16',
      eventStatus: 'https://schema.org/EventScheduled',
      eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
      location: {
        '@type': 'Place',
        name: `Chhath Ghats, ${city.name}`,
        address: { '@type': 'PostalAddress', addressLocality: city.name, addressRegion: city.state, addressCountry: 'IN' },
      },
      description: `Chhath Puja 2026 (13-16 November) ghats and sites in ${city.name} on the ${city.water}. Sandhya Arghya at sunset ${sunset15} on 15 Nov; Usha Arghya at sunrise ${sunrise16} on 16 Nov.`,
      url: `${BASE}/chhath/${city.slug}`,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${BASE}/` },
        { '@type': 'ListItem', position: 2, name: 'Chhath Puja 2026 Ghats', item: `${BASE}/chhath/` },
        { '@type': 'ListItem', position: 3, name: city.name, item: `${BASE}/chhath/${city.slug}` },
      ],
    },
  ],
});

const title = `Chhath Puja 2026 Ghats in ${city.name} — Complete List & Arghya Timing (13-16 November)`;
const description = `Chhath Puja 2026 ghats in ${city.name}, ${city.state} — ${city.ghats.slice(0, 4).join(', ')} and more on the ${city.water}. Arghya timings, dates (13-16 Nov 2026) and administration advisories.`;
---

<Layout title={title} description={description}>
  <script slot="head" type="application/ld+json" set:html={jsonLd} is:inline />

  <section class="hero">
    <p class="crumb"><a href="/chhath/">Chhath Puja 2026</a> › {city.name}</p>
    <h1>Chhath Puja 2026 Ghats in {city.name}</h1>
    <p>
      Chhath Puja 2026 in {city.name}, {city.state} falls on <strong>13-16 November 2026</strong>.
      Devotees offer arghya to the Sun God at {city.ghats.length}+ major sites on the {city.water}.
    </p>
  </section>

  <section class="timings">
    <h2>Arghya Timings in {city.name}</h2>
    <div class="timing-cards">
      <div class="tcard">
        <p class="tlabel">Sandhya Arghya — 15 Nov (evening)</p>
        <p class="tval">🌇 {sunset15}</p>
        <p class="tsub">Offer arghya to the setting sun</p>
      </div>
      <div class="tcard">
        <p class="tlabel">Usha Arghya — 16 Nov (morning)</p>
        <p class="tval">🌅 {sunrise16}</p>
        <p class="tsub">Offer arghya to the rising sun & end the vrat</p>
      </div>
    </div>
    <p class="tdisclaimer">Timings computed for {city.name}'s coordinates — approximate (±2-3 min). Local panchang timings may differ slightly.</p>
  </section>

  <section class="dates">
    <h2>Dates & Rituals</h2>
    <table>
      <thead><tr><th>Day</th><th>Ritual</th><th>Date</th></tr></thead>
      <tbody>
        {chhathDates2026.map((d) => (
          <tr><td>{d.day}</td><td>{d.ritual}</td><td><strong>{d.date}</strong></td></tr>
        ))}
      </tbody>
    </table>
  </section>

  <section class="ghats">
    <h2>Major Chhath Ghats & Sites in {city.name}</h2>
    <p class="sub">Water body: <strong>{city.water}</strong></p>
    <ul class="ghat-list">
      {city.ghats.map((g) => (
        <li>{g}</li>
      ))}
    </ul>
  </section>

  <section class="notes">
    <h2>Good to Know — {city.name}</h2>
    <p>{city.notes}</p>
    <p class="disclaimer">
      Note: compiled from district administration advisories and news reports from the 2024-25
      festival seasons. Ghat lists and bans change yearly — confirm with the latest local advisory.
    </p>
  </section>

  <section class="related">
    <h2>Chhath Ghats in Other Cities</h2>
    <ul class="other-cities">
      {others.slice(0, 24).map((c) => (
        <li><a href={`/chhath/${c.slug}`}>{c.name}</a></li>
      ))}
    </ul>
    <p><a href="/chhath/">See all 39 cities →</a></p>
    <p>
      <a href="https://mapsnearme.pages.dev/search" target="_blank" rel="noopener">
        Find businesses near Chhath ghats on mapsnearme →
      </a>
    </p>
  </section>
</Layout>

<style>
  .hero { text-align: center; padding: 2rem 1rem 1rem; }
  .crumb { font-size: .85rem; }
  .timings { padding: 1rem; }
  .timing-cards { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }
  .tcard { border: 1px solid #e5c07b; background: #fffaf0; border-radius: 10px; padding: 1rem 1.5rem; text-align: center; min-width: 220px; }
  .tlabel { font-size: .85rem; color: #555; margin: 0; }
  .tval { font-size: 1.5rem; font-weight: 800; color: #8a6d1f; margin: .3rem 0; }
  .tsub { font-size: .8rem; color: #777; margin: 0; }
  .tdisclaimer { text-align: center; color: #999; font-size: .8rem; margin-top: .8rem; }
  .dates { padding: 1rem; }
  table { border-collapse: collapse; width: 100%; max-width: 640px; margin: 0 auto; }
  th, td { border: 1px solid #ddd; padding: .5rem .75rem; text-align: left; }
  th { background: #f5f5f5; }
  .ghats { padding: 1rem; }
  .sub { color: #555; }
  .ghat-list { columns: 2; list-style: none; padding: 0; max-width: 860px; }
  .ghat-list li { padding: .4rem 0; border-bottom: 1px dashed #e5e5e5; }
  .ghat-list li::before { content: '🌊 '; }
  .notes { padding: 1rem; max-width: 760px; }
  .disclaimer { color: #777; font-size: .85rem; }
  .related { padding: 1rem; }
  .other-cities { list-style: none; padding: 0; columns: 3; }
  .other-cities li { padding: .25rem 0; }
  @media (max-width: 600px) { .ghat-list, .other-cities { columns: 1; } }
</style>
