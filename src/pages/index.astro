---
import Layout from '../layouts/Base.astro';
import { getStates } from '../lib/db';
import { chhathCities, chhathDates2026 } from '../data/chhath';
import { festivalCities } from '../data/cities';
import { stateUrl } from '../lib/urls';

export const prerender = false;
const states = await getStates(Astro.locals.runtime.env.DB);
---
<Layout
  title="India Pincode Directory — Search 6 Lakh Villages, Panchayats & Pincodes"
  description="Find any Indian pincode, village, or panchayat with LGD codes and local body details. Complete directory of 6 lakh villages and 1.5 lakh+ pincodes, searchable by state and district."
>
  <section class="hero">
    <h1>📮 India Pincode Directory</h1>
    <p class="sub">Every pincode, village, and panchayat in India — searchable.</p>
    <div class="chips">
      <span class="chip">🏘️ 6 lakh villages</span>
      <span class="chip">📮 1.5 lakh+ pincodes</span>
      <span class="chip">🏛️ Panchayat & LGD data</span>
      <span class="chip">🛰️ DIGIPIN codes</span>
    </div>
    <form action="/search" method="get" class="search" style="margin-top:1rem;display:flex;gap:.5rem;flex-wrap:wrap">
      <input type="search" name="q" placeholder="Search pincode, village, district…" style="flex:1;min-width:220px;padding:.7rem .9rem;border:1px solid var(--line);border-radius:10px;font-size:1rem" />
      <button type="submit" style="padding:.7rem 1.3rem;border:none;border-radius:10px;background:#fff;color:var(--navy);font-weight:700;font-size:.95rem;cursor:pointer">Search</button>
    </form>
  </section>

  <section class="digipin-banner">
    <h2>🛰️ DIGIPIN — India Post's Digital Address Code</h2>
    <p>Every ~4m spot in India now has a unique 10-character digital address. Find your DIGIPIN on a map, decode any DIGIPIN code, and learn how it works — free, right in your browser.</p>
    <p><a href="/digipin/">Find your DIGIPIN →</a></p>
  </section>

  <section class="fest-banner">
    <h2>🪔 Festival Season 2026</h2>
    <div class="fest-grid">
      <div class="fest-card kc">
        <h3>🌙 Karva Chauth — 29 October</h3>
        <p>Moonrise time for {festivalCities.length} cities, sargi deadline, muhurat & vrat vidhi.</p>
        <p><a href="/karva-chauth/">Karva Chauth 2026 moonrise timings →</a></p>
      </div>
      <div class="fest-card diwali">
        <h3>🪔 Diwali — 8 November</h3>
        <p>Lakshmi Puja muhurat & city-wise timings for {festivalCities.length} cities, full 5-day calendar, samagri & vidhi.</p>
        <p><a href="/diwali/">Diwali 2026 city-wise timings →</a></p>
      </div>
      <div class="fest-card chhath">
        <h3>🌊 Chhath Puja — 13-16 November</h3>
        <p>Chhath ghats, ponds and beaches in {chhathCities.length} cities: Patna, Delhi, Varanasi, Lucknow & more.</p>
        <p><a href="/chhath/">View all Chhath Puja 2026 ghats →</a></p>
      </div>
    </div>
  </section>

  <h2>Browse by State</h2>
  <p class="intro">Pick a state to drill down: <strong>state → district → tehsil → village → pincode</strong>. Every level has verified data — populations, LGD codes, post offices, panchayats and DIGIPIN where available.</p>
  <div class="cards">
    {states.map(s => (
      <div class="card">
        <a href={stateUrl(s.slug)}>{s.name}</a>
        <p class="d">Districts · tehsils · villages · pincodes</p>
      </div>
    ))}
  </div>
</Layout>

<style>
  .fest-banner {
    background: #fff8ec;
    border: 1px solid #f0dcb4;
    border-radius: 10px;
    padding: 1.2rem 1.5rem;
    margin: 0 0 2rem;
    text-align: center;
  }
  .fest-banner h2 { margin: 0 0 .8rem; font-size: 1.25rem; }
  .fest-grid { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }
  .fest-card { flex: 1 1 240px; max-width: 320px; border-radius: 10px; padding: .9rem 1.1rem; text-align: left; }
  .fest-card.kc { background: #f3f0fa; border: 1px solid #d9d0ee; }
  .fest-card.diwali { background: #fdf1e3; border: 1px solid #f0dcb4; }
  .fest-card.chhath { background: #e9f4f9; border: 1px solid #c9e2ee; }
  .fest-card h3 { margin: 0 0 .4rem; font-size: 1rem; }
  .fest-card p { margin: .3rem 0; font-size: .88rem; }
  .digipin-banner {
    background: #eef4ff;
    border: 1px solid #cddcf8;
    border-radius: 10px;
    padding: 1.2rem 1.5rem;
    margin: 0 0 2rem;
    text-align: center;
  }
  .digipin-banner h2 { margin: 0 0 .5rem; font-size: 1.25rem; }
  .digipin-banner p { margin: .35rem 0; font-size: .92rem; }
  .digipin-banner a { font-weight: 700; }
</style>
