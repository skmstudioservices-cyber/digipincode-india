---
import Layout from '../layouts/Base.astro';
import { getStates } from '../lib/db';
import { chhathCities, chhathDates2026 } from '../data/chhath';

export const prerender = false;
const states = await getStates(Astro.locals.runtime.env.DB);
---
<Layout
  title="India Pincode Directory — Search 6 Lakh Villages, Panchayats & Pincodes"
  description="Find any Indian pincode, village, or panchayat with LGD codes and local body details. Complete directory of 6 lakh villages and 1.5 lakh+ pincodes, searchable by state and district."
>
  <section class="hero">
    <h1>India Pincode Directory</h1>
    <p>Every pincode, village, and panchayat in India — searchable.</p>
    <form action="/search" method="get" class="search">
      <input type="search" name="q" placeholder="Search pincode, village, district…" />
      <button type="submit">Search</button>
    </form>
  </section>

  <section class="chhath-banner">
    <h2>🌊 Chhath Puja 2026 — Ghat Directory</h2>
    <p>
      {chhathDates2026[0].date.split(', ')[1]} se {chhathDates2026[3].date.split(', ')[1]} — find Chhath ghats, ponds and beaches
      in {chhathCities.length} cities: Patna, Delhi, Varanasi, Lucknow, Mumbai, Bengaluru, Hyderabad & more.
    </p>
    <p><a href="/chhath/">View all Chhath Puja 2026 ghats →</a></p>
  </section>

  <section class="states">
    <h2>Browse by State</h2>
    <ul>
      {states.map((s) => (
        <li><a href={`/state/${s.slug}`}>{s.name}</a></li>
      ))}
    </ul>
  </section>
</Layout>

<style>
  .hero { text-align: center; padding: 3rem 1rem; }
  .search input { padding: .6rem; width: 60%; max-width: 480px; }
  .chhath-banner {
    background: #fff8ec;
    border: 1px solid #f0dcb4;
    border-radius: 10px;
    padding: 1.2rem 1.5rem;
    margin: 0 0 2rem;
    text-align: center;
  }
  .chhath-banner h2 { margin: 0 0 .4rem; font-size: 1.25rem; }
  .chhath-banner p { margin: .3rem 0; }
  .states ul { columns: 3; list-style: none; padding: 0; }
  .states li { padding: .25rem 0; }
  @media (max-width: 600px) { .states ul { columns: 1; } }
</style>
