{
  "name": "skm-ai-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  },
  "triggers": {
    "crons": ["0 */6 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pincode-india",
      "database_id": "YOUR_D1_DATABASE_ID"
    }
  ],
  "ai": {
    "binding": "AI"
  }
}
